.vscode/
.gradle/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Crash / build reports
sysinfo.txt
*.stackdump
crashlog.txt

# neovim
.nvim.lua

# Agents
Agents~
AGENTS.md
AGENTS.md.meta 
AGENTS_UnityEditor.md
AGENTS_UnityEditor.md.meta
Claude.md
